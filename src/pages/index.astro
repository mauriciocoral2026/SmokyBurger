---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { productos } from '../data/menu';

const hero = productos.find((p) => p.slug === 'alma-de-barrica') ?? productos[0];
const heroImg = hero?.foto || '/img/burgers/alma-barrica.jpg';
const heroW = hero?.fotoW || 1792;
const heroH = hero?.fotoH || 1983;
const heroVideos = ['/img/burgers/video-barril.mp4'];
---
<Base>
  <section class="relative flex min-h-[100svh] w-full max-w-full items-center justify-center overflow-hidden">
    <div class="absolute inset-0 w-full overflow-hidden">
      <Image
        src={heroImg}
        alt=""
        width={heroW}
        height={heroH}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hero-bg hero-fallback absolute inset-0 z-[1] h-full w-full object-cover object-center opacity-100 transition-opacity duration-1000 ease-in-out drop-shadow-[0_0_36px_rgba(255,85,0,0.22)]"
      />
      <video
        class="hero-video pointer-events-none absolute inset-0 z-[1] h-full w-full object-cover object-center opacity-0 transition-opacity duration-1000 ease-in-out"
        muted
        playsinline
        preload="none"
        poster={heroImg}
        aria-hidden="true"
        data-videos={JSON.stringify(heroVideos)}
      ></video>
      <div class="absolute inset-0 z-[2] bg-gradient-to-t from-[#0D0D0D] via-[#0D0D0D]/60 to-[#0D0D0D]/80"></div>
    </div>
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const video = document.querySelector('.hero-video');
      const fallback = document.querySelector('.hero-fallback');

      if (!reduceMotion.matches && video instanceof HTMLVideoElement && fallback instanceof HTMLElement) {
        let videos = ['/img/burgers/video-barril.mp4'];
        try {
          const parsed = JSON.parse(video.dataset.videos || '[]');
          if (Array.isArray(parsed) && parsed.filter(Boolean).length) {
            videos = parsed.filter((v) => typeof v === 'string' && v);
          }
        } catch {}

        let lastIndex = -1;
        const pickVideoIndex = () => {
          if (videos.length === 1) {
            lastIndex = 0;
            return 0;
          }
          let idx = Math.floor(Math.random() * videos.length);
          if (idx === lastIndex) idx = (idx + 1) % videos.length;
          lastIndex = idx;
          return idx;
        };

        const showImage = () => {
          fallback.classList.remove('opacity-0');
          fallback.classList.add('opacity-100');
          video.classList.remove('opacity-100');
          video.classList.add('opacity-0', 'pointer-events-none');
          video.pause();
          window.setTimeout(showVideo, 10000);
        };

        const showVideo = async () => {
          const idx = pickVideoIndex();
          if (video.getAttribute('src') !== videos[idx]) {
            video.src = videos[idx];
          }
          try {
            video.currentTime = 0;
          } catch {}
          try {
            await video.play();
          } catch {
            window.setTimeout(showVideo, 10000);
            return;
          }
          video.classList.remove('opacity-0', 'pointer-events-none');
          video.classList.add('opacity-100');
          fallback.classList.remove('opacity-100');
          fallback.classList.add('opacity-0');
          window.setTimeout(showImage, 5000);
        };

        window.setTimeout(showVideo, 10000);
      }
    </script>
    <div class="relative z-[3] mx-auto max-w-6xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-8">
        <span class="inline-block rounded-full border border-white/15 bg-white/5 px-5 py-2 text-xs font-medium uppercase tracking-[0.2em] text-[#FF5500]/90 backdrop-blur-md sm:text-sm">
          🔥 AHUMADAS AL BARRIL • AFUERA DE NEW PEOPLE
        </span>
      </div>
      <h1 class="font-display text-5xl font-bold uppercase leading-none tracking-tight text-[#F5F5F5] md:text-7xl">
        <span class="block">SMOKY BURGER</span>
        <span class="mt-2 block">
          NO ES PARRILLA ES <span class="text-[#FF5500] [text-shadow:0_0_20px_rgba(255,85,0,0.35)]">HUMO</span>
        </span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-[#A3A3A3] sm:text-lg">
        Burgers artesanales ahumadas al barril en Cartago. Encuéntranos afuera de New People o pídelas con despacho rápido y caliente hasta tu puerta.
      </p>
      <div class="mt-10">
        <a href="/menu" class="inline-flex items-center justify-center rounded-xl bg-[#FF5500] px-10 py-4 text-base font-bold text-white shadow-lg shadow-orange-600/40 transition duration-200 hover:scale-[1.02] hover:bg-[#E04800]">
          PEDIR AHORA
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-bg {
    --zoom-from: 1.08;
    --zoom-to: 1;
    transform: scale(var(--zoom-from));
    transform-origin: center center;
    animation: hero-zoom 10s linear forwards;
    will-change: transform;
    max-width: none;
  }

  @keyframes hero-zoom {
    from {
      transform: scale(var(--zoom-from));
    }
    to {
      transform: scale(var(--zoom-to));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-fallback {
      display: block !important;
      opacity: 1 !important;
      animation: none;
      transform: scale(1);
    }
    .hero-video {
      display: none !important;
    }
  }
</style>
