---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { productos } from '../data/menu';
import { config, whatsappLink } from '../config';

const populares = productos.filter((p) => p.popular);
const heroImg = productos[0]?.foto || '/img/burgers/explosion-de-barril.svg';
---
<Base>
  <section class="relative flex min-h-screen items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <img src={heroImg} alt="" class="h-full w-full object-cover object-center" />
      <div class="absolute inset-0 bg-black/70"></div>
    </div>
    <div class="relative mx-auto max-w-6xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-8">
        <span class="inline-block rounded-full border border-[#ff520d] bg-black/40 px-6 py-2 text-xs font-light uppercase tracking-[0.3em] text-[#ff520d]">
          BIENVENIDOS
        </span>
      </div>
      <h1 class="text-7xl font-black uppercase leading-[0.9] tracking-tight sm:text-8xl lg:text-[12rem]">
        <span class="text-white">SMOKY</span>
        <br />
        <span class="text-[#ff520d]">BURGER</span>
      </h1>
      <hr class="mx-auto mt-8 w-16 border-t-2 border-[#ff520d]" />
      <p class="mt-6 text-sm font-medium uppercase tracking-[0.25em] text-white/80 sm:text-base">
        NO ES PARRILLA ES HUMO
      </p>
      <div class="mt-10">
        <a href="/menu" class="inline-block rounded-full bg-[#ff520d] px-14 py-4 text-base font-bold uppercase tracking-wider text-white hover:bg-[#e0480b]">
          PEDIR AHORA
        </a>
      </div>
    </div>
  </section>
</Base>
