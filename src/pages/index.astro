---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { productos } from '../data/menu';

const hero = productos.find((p) => p.slug === 'alma-de-barrica') ?? productos[0];
const heroImg = hero?.foto || '/img/burgers/alma-barrica.jpg';
const heroW = hero?.fotoW || 1792;
const heroH = hero?.fotoH || 1983;
---
<Base>
  <section class="relative flex min-h-[100svh] w-full max-w-full items-center justify-center overflow-hidden">
    <div class="absolute inset-0 w-full overflow-hidden">
      <Image
        src={heroImg}
        alt=""
        width={heroW}
        height={heroH}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hero-bg hero-fallback absolute inset-0 block h-full w-full object-cover object-center md:object-center"
      />
      <video
        class="hero-video absolute inset-0 hidden h-full w-full object-cover object-center md:block"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={heroImg}
        aria-hidden="true"
      >
        <source src="/img/burgers/video-barril.mp4" type="video/mp4" />
      </video>
      <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/55 to-black/75"></div>
    </div>
    <div class="relative mx-auto max-w-6xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-8">
        <span class="inline-block rounded-full border border-[#ff520d] bg-black/40 px-6 py-2 text-xs font-light uppercase tracking-[0.3em] text-[#ff520d]">
          BIENVENIDOS
        </span>
      </div>
      <h1 class="text-[clamp(3.25rem,18vw,12rem)] font-black uppercase leading-[0.9] tracking-tight">
        <span class="text-white">SMOKY</span>
        <br />
        <span class="text-[#ff520d]">BURGER</span>
      </h1>
      <hr class="mx-auto mt-8 w-16 border-t-2 border-[#ff520d]" />
      <p class="mt-6 text-sm font-medium uppercase tracking-[0.25em] text-white/80 sm:text-base">
        NO ES PARRILLA ES HUMO
      </p>
      <div class="mt-10">
        <a href="/menu" class="inline-block rounded-full bg-[#ff520d] px-14 py-4 text-base font-bold uppercase tracking-wider text-white hover:bg-[#e0480b]">
          PEDIR AHORA
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-bg {
    --zoom-from: 1;
    --zoom-to: 1;
    transform: scale(1);
    transform-origin: center center;
    animation: none;
    will-change: transform;
    max-width: none;
  }

  @keyframes hero-zoom {
    from {
      transform: scale(var(--zoom-from));
    }
    to {
      transform: scale(var(--zoom-to));
    }
  }

  @media (min-width: 768px) {
    .hero-fallback {
      --zoom-from: 1.03;
      --zoom-to: 1.08;
      transform: scale(var(--zoom-from));
      animation: hero-zoom 18s ease-in-out infinite alternate;
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-fallback {
      display: block !important;
      animation: none;
      transform: scale(1);
    }
    .hero-video {
      display: none !important;
    }
  }
</style>
