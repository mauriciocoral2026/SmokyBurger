---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { productos, categorias } from '../data/menu';
---
<Base title="Menú" description="Menú SmokyBurger: burgers ahumadas al barril. Pide online y paga por WhatsApp.">
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="mb-8">
      <h1 class="font-display text-4xl font-bold uppercase tracking-tight text-[#F5F5F5] sm:text-5xl">Menú</h1>
      <div class="mt-3 h-1 w-20 rounded-full bg-[#FF5500]"></div>
      <p class="mt-4 text-base text-[#A3A3A3]">Burgers ahumadas al barril</p>
    </div>

    <div class="sticky top-16 z-30 -mx-4 mt-6 border-y border-[#2A2A2A] bg-[#0D0D0D]/90 px-4 py-3 backdrop-blur-md sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8">
      <nav class="no-scrollbar flex gap-2 overflow-x-auto">
        {categorias.map((c, i) => (
          <a
            href={`#${c.toLowerCase().replace(/\s+/g, '-')}`}
            class:list={[
              'whitespace-nowrap rounded-full border px-4 py-1.5 text-sm font-medium transition-colors',
              i === 0
                ? 'border-[#FF5500] bg-[#FF5500] text-white'
                : 'border-[#2A2A2A] bg-[#181818] text-[#A3A3A3] hover:border-[#FF5500]/50 hover:text-[#F5F5F5]',
            ]}
          >
            {c}
          </a>
        ))}
      </nav>
    </div>

    {categorias.map((cat) => {
      const items = productos.filter((p) => p.categoria === cat);
      return (
        <section id={cat.toLowerCase().replace(/\s+/g, '-')} class="mt-10 scroll-mt-36">
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {items.map((p) => <ProductCard producto={p} />)}
          </div>
        </section>
      );
    })}
  </section>

  <div id="product-modal" class="fixed inset-0 z-[70] hidden items-end justify-center p-0 sm:items-center sm:p-4" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div id="product-modal-backdrop" data-modal-close class="absolute inset-0 bg-black/80 backdrop-blur-md"></div>
    <div class="relative z-10 w-full max-w-4xl overflow-hidden rounded-t-3xl border border-white/10 bg-[#161616] shadow-2xl sm:rounded-3xl">
      <button
        id="modal-close-btn"
        type="button"
        data-modal-close
        aria-label="Cerrar"
        class="absolute right-3 top-3 z-20 inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-white/15 bg-black/60 text-white backdrop-blur-md transition-all hover:bg-orange-500 active:scale-95 sm:right-4 sm:top-4"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div class="grid max-h-[90vh] grid-cols-1 overflow-y-auto md:max-h-[85vh] md:grid-cols-2 md:overflow-hidden">
        <div class="flex items-center justify-center bg-[#0B0B0B] p-4 md:p-6">
          <img id="modal-image" src="" alt="" class="h-auto w-full max-h-[42vh] rounded-xl object-contain md:max-h-[65vh]" />
        </div>

        <div class="flex flex-col p-5 sm:p-7 md:max-h-[85vh] md:overflow-y-auto">
          <span id="modal-badge" class="inline-flex w-fit items-center rounded-full border border-[#FF5500]/30 bg-[#FF5500]/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-[#FF5500]">🔥 ESPECIALIDAD AL BARRIL</span>
          <h2 id="modal-title" class="mt-4 font-display text-3xl font-bold uppercase leading-none text-[#F5F5F5] md:text-4xl"></h2>
          <p id="modal-description" class="mt-4 text-sm leading-relaxed text-[#A3A3A3] md:text-base"></p>

          <div class="mt-6">
            <h3 class="text-xs font-bold uppercase tracking-wider text-orange-400">Ingredientes</h3>
            <ul id="modal-ingredients" class="mt-3 flex flex-wrap gap-2"></ul>
          </div>

          <div class="mt-6 border-t border-white/10 pt-4 md:mt-auto">
            <div class="flex items-center justify-between gap-4">
              <span id="modal-price" class="text-2xl font-bold text-white"></span>
              <button
                id="modal-add-btn"
                type="button"
                data-add-to-cart=""
                class="inline-flex cursor-pointer items-center justify-center rounded-xl bg-[#FF5500] px-5 py-3 text-sm font-bold text-white shadow-lg shadow-orange-600/30 transition-all hover:bg-[#E04800] active:scale-95"
              >
                Agregar al pedido
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const modal = document.getElementById('product-modal');
    const modalImage = document.getElementById('modal-image') as HTMLImageElement | null;
    const modalBadge = document.getElementById('modal-badge');
    const modalTitle = document.getElementById('modal-title');
    const modalDesc = document.getElementById('modal-description');
    const modalIngredients = document.getElementById('modal-ingredients');
    const modalPrice = document.getElementById('modal-price');
    const modalAddBtn = document.getElementById('modal-add-btn') as HTMLButtonElement | null;

    function openModal(product) {
      if (!modal || !modalImage || !modalBadge || !modalTitle || !modalDesc || !modalIngredients || !modalPrice || !modalAddBtn) return;
      modalImage.src = product.foto || '';
      modalImage.alt = product.nombreCompleto || product.nombre || '';
      modalBadge.textContent = product.badge || '🔥 ESPECIALIDAD AL BARRIL';
      modalTitle.textContent = product.nombre || '';
      modalDesc.textContent = product.descripcion || '';
      modalIngredients.innerHTML = '';
      (product.ingredientes || []).forEach((ing) => {
        const li = document.createElement('li');
        li.className = 'rounded-lg border border-white/10 bg-white/5 px-2.5 py-1 text-xs text-neutral-200';
        li.textContent = ing;
        modalIngredients.appendChild(li);
      });
      modalPrice.textContent = product.precioLabel || '';
      modalAddBtn.setAttribute('data-add-to-cart', product.id || '');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const trigger = target?.closest('[data-product-open]') as HTMLElement | null;
      if (trigger) {
        e.preventDefault();
        const card = trigger.closest('article[data-product]') as HTMLElement | null;
        if (!card) return;
        try {
          const product = JSON.parse(card.dataset.product || '{}');
          openModal(product);
        } catch {}
        return;
      }
      if (target?.closest('[data-modal-close]')) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  </script>
</Base>
