---
import Base from '../layouts/Base.astro';
import { config, whatsappLink } from '../config';
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(config.address)}`;
---
<Base title="Ubicación y atención" description={`${config.brand} en Cartago, afuera de New People. Come al paso, recoge o pide a domicilio en ${config.deliveryZone}.`}>
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <h1 class="font-display text-4xl uppercase tracking-tight text-[#F5F5F5] sm:text-5xl">Ubicación y atención</h1>
    <p class="mt-3 max-w-2xl text-base text-[#A3A3A3]">Encuéntranos <strong class="font-semibold text-[#F5F5F5]">afuera de New People, Cartago</strong>. Come al paso, recoge tu pedido o solicita despacho rápido y caliente a tu puerta.</p>

    <div class="mt-8 grid gap-5 lg:grid-cols-3">
      <article class="rounded-2xl border border-white/10 bg-[#181818] p-6">
        <div class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-[#FF5500]/10 text-[#FF5500]">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        </div>
        <p class="text-xs font-semibold uppercase tracking-wide text-[#FF5500]">Punto de venta al barril</p>
        <h3 class="mt-1 text-lg font-bold text-[#F5F5F5]">Afuera de New People, Cartago</h3>
        <p class="mt-2 text-sm font-medium text-[#F5F5F5]">{config.address}</p>
        <p class="mt-2 text-sm text-[#A3A3A3]">Come al paso, recoge o pide a domicilio en {config.deliveryZone}.</p>
        <a href={mapsUrl} target="_blank" rel="noreferrer" class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#FF5500] px-5 py-3 text-sm font-bold text-white shadow-lg shadow-orange-600/30 transition-colors hover:bg-[#E04800] sm:w-auto">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          Cómo llegar
        </a>
      </article>

      <article class="rounded-2xl border border-white/10 bg-[#181818] p-6">
        <div class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-[#FF5500]/10 text-[#FF5500]">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        </div>
        <p class="text-xs font-semibold uppercase tracking-wide text-[#FF5500]">Despacho Rápido y Caliente</p>
        <h3 class="mt-1 text-lg font-bold text-[#F5F5F5]">Horarios</h3>
        <ul class="mt-2 space-y-1 text-sm text-[#A3A3A3]">
          {config.hours.map((h) => <li>{h.days}: <strong class="font-semibold text-[#F5F5F5]">{h.time}</strong></li>)}
        </ul>
      </article>

      <article class="rounded-2xl border border-white/10 bg-[#181818] p-6">
        <div class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-[#FF5500]/10 text-[#FF5500]">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.63 2.62a2 2 0 0 1-.45 2.11L8 9.91a16 16 0 0 0 6 6l1.46-1.29a2 2 0 0 1 2.11-.45c.84.3 1.72.51 2.62.63A2 2 0 0 1 22 16.92z"></path></svg>
        </div>
        <p class="text-xs font-semibold uppercase tracking-wide text-[#FF5500]">Pide directo</p>
        <h3 class="mt-1 text-lg font-bold text-[#F5F5F5]">WhatsApp</h3>
        <p class="mt-2 text-sm text-[#A3A3A3]">WhatsApp {config.whatsappDisplay}</p>
        <p class="text-sm text-[#A3A3A3]">{config.email}</p>
        <a href={whatsappLink('Hola, ¿llegan a mi barrio?')} target="_blank" rel="noreferrer" class="mt-4 inline-flex items-center justify-center rounded-xl bg-[#FF5500] px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[#E04800]">Preguntar cobertura</a>
      </article>
    </div>

    <div class="mt-8 overflow-hidden rounded-2xl border border-white/10 bg-[#181818]">
      <iframe
        title="Mapa de ubicación"
        src="https://www.google.com/maps?q=Cra.+5N+%2319-114%2C+Cartago%2C+Valle+del+Cauca%2C+Colombia&output=embed"
        class="h-[360px] w-full"
        loading="lazy"
      ></iframe>
    </div>
  </section>
</Base>
