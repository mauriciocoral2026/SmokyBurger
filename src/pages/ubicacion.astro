---
import Base from '../layouts/Base.astro';
import { config } from '../config';
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(config.address)}`;
---
<Base title="Ubicación y horarios" description={`${config.brand} en Cartago, afuera de New People. Come al paso, recoge o pide a domicilio en ${config.deliveryZone}.`}>
  <section id="ubicacion" class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="rounded-3xl border border-white/10 bg-[#161616] p-6 md:p-10">
      <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-2">
        <div>
          <span class="inline-flex items-center rounded-full border border-orange-500/30 bg-orange-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-orange-300">📍 PUNTO AL BARRIL • CARTAGO</span>
          <h1 class="mt-4 font-display text-3xl uppercase leading-tight text-[#F5F5F5] md:text-5xl">ENCUÉNTRANOS AFUERA DE NEW PEOPLE</h1>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-[#A3A3A3]">Ven por tu burger recién salida del humo antes o después de jugar, o pídela a domicilio caliente hasta tu puerta.</p>

          <div class="mt-6 flex items-start gap-3 rounded-2xl border border-white/10 bg-[#1C1C1C] p-4">
            <div class="mt-0.5 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#FF5500]/10 text-[#FF5500]">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <p class="text-sm font-medium text-[#F5F5F5] sm:text-base"><span class="text-[#A3A3A3]">Atención:</span> Viernes de 4:00 PM – 9:00 PM</p>
          </div>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a href={mapsUrl} target="_blank" rel="noreferrer" class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl bg-[#FF5500] px-5 py-3 text-sm font-bold text-white shadow-lg shadow-orange-600/30 transition-all hover:bg-[#E04800] active:scale-95">
              Cómo llegar (Google Maps) ↗
            </a>
            <a href={`https://wa.me/${config.whatsappNumber}`} target="_blank" rel="noreferrer" class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-[#25D366]/40 bg-[#25D366]/15 px-5 py-3 text-sm font-bold text-[#CFF7DF] transition-all hover:bg-[#25D366]/25 active:scale-95">
              Escribir al WhatsApp
            </a>
          </div>
        </div>

        <div class="h-64 overflow-hidden rounded-2xl border border-white/10 md:h-80">
          <iframe
            title="Mapa de ubicación SmokyBurger"
            src="https://www.google.com/maps?q=Cra.+5N+%2319-114%2C+Cartago%2C+Valle+del+Cauca%2C+Colombia&output=embed"
            class="h-full w-full grayscale contrast-125 opacity-90 transition-all hover:opacity-100"
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</Base>
