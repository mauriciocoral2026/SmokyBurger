---
import Base from '../layouts/Base.astro';
import { config, whatsappLink } from '../config';
---
<Base title="Ubicación y despacho" description={`Cobertura de despacho ${config.brand}: ${config.deliveryZone}. Horarios y WhatsApp.`}>
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <h1 class="font-display text-4xl uppercase text-ink sm:text-5xl">Ubicación y despacho</h1>
    <p class="mt-2 max-w-2xl text-ink/70">Somos cocina oculta: no tenemos salón, despachamos a domicilio. Pregunta por tu barrio antes de pedir.</p>

    <div class="mt-8 grid gap-5 lg:grid-cols-3">
      <article class="border border-ink/10 bg-white p-5 text-ink shadow-sm">
        <h3 class="text-lg font-extrabold">Cobertura</h3>
        <p class="mt-2 text-sm text-smoke">{config.deliveryZone}</p>
        <p class="mt-3 text-sm text-smoke">{config.address}</p>
      </article>
      <article class="border border-ink/10 bg-white p-5 text-ink shadow-sm">
        <h3 class="text-lg font-extrabold">Horarios</h3>
        <ul class="mt-2 space-y-1 text-sm text-smoke">
          {config.hours.map((h) => <li>{h.days}: <strong class="text-ink">{h.time}</strong></li>)}
        </ul>
      </article>
      <article class="bg-ink p-5 text-cream">
        <h3 class="text-lg font-extrabold">Pide directo</h3>
        <p class="mt-2 text-sm text-cream/80">WhatsApp {config.whatsappDisplay}</p>
        <p class="text-sm text-cream/80">{config.email}</p>
        <a href={whatsappLink('Hola, ¿llegan a mi barrio?')} target="_blank" rel="noreferrer" class="mt-4 inline-block bg-ember px-5 py-2.5 text-sm font-extrabold uppercase tracking-wide text-white hover:bg-ember-dark">Preguntar cobertura</a>
      </article>
    </div>

    <div class="mt-8 overflow-hidden border border-ink/10 bg-white">
      <iframe
        title="Mapa de cobertura"
        src="https://www.google.com/maps?q=Cartago%2C+Valle+del+Cauca%2C+Colombia&output=embed"
        class="h-[360px] w-full"
        loading="lazy"
      ></iframe>
    </div>
  </section>
</Base>
