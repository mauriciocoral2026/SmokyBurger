---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { productos, getProducto, formatCOP } from '../../data/menu';

export function getStaticPaths() {
  return productos.map((p) => ({ params: { slug: p.slug }, props: { producto: p } }));
}
const { producto } = Astro.props as { producto: (typeof productos)[0] };
const p = producto ?? getProducto(Astro.params.slug!);
if (!p) throw new Error('Producto no encontrado: ' + Astro.params.slug);
const nombre = p.nombre.replace(' — Smoky Burger', '');
const badge = p.popular ? 'Recomendada' : (p.badge ?? '🔥 ESPECIALIDAD AL BARRIL');
---
<Base title={p.nombre} description={p.descripcion} image={p.foto}>
  <section class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:py-12">
    <a href="/menu" class="mb-4 inline-flex items-center gap-2 text-sm font-medium text-[#A3A3A3] transition-colors hover:text-[#F5F5F5]">
      <span aria-hidden="true">←</span> Volver al menú
    </a>

    <div class="overflow-hidden rounded-2xl border border-white/10 bg-[#161616] shadow-2xl md:rounded-3xl">
      <div class="grid grid-cols-1 md:grid-cols-2">
        <div class="flex items-center justify-center bg-[#0B0B0B] p-4 md:p-6">
          <Image
            src={p.foto}
            alt={p.nombre}
            width={p.fotoW}
            height={p.fotoH}
            loading="eager"
            decoding="async"
            class="h-auto w-full max-h-[50vh] rounded-xl object-contain md:max-h-[65vh]"
          />
        </div>

        <div class="flex flex-col p-5 sm:p-7 md:p-8">
          <span class="inline-flex w-fit items-center rounded-full border border-[#FF5500]/30 bg-[#FF5500]/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-[#FF5500]">{badge}</span>
          <h1 class="mt-4 font-display text-3xl font-bold uppercase leading-none text-[#F5F5F5] md:text-4xl">{nombre}</h1>
          <p class="mt-4 text-sm leading-relaxed text-[#A3A3A3] md:text-base">{p.descripcion}</p>

          <div class="mt-6">
            <h2 class="text-xs font-bold uppercase tracking-wider text-orange-400">Ingredientes</h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {p.ingredientes.map((ing) => (
                <li class="rounded-lg border border-white/10 bg-white/5 px-2.5 py-1 text-xs text-neutral-200">{ing}</li>
              ))}
            </ul>
          </div>

          <div class="mt-6 border-t border-white/10 pt-5 md:mt-auto">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div class="flex items-center gap-4">
                <div class="flex items-center rounded-xl border border-white/10 bg-[#1A1A1A]">
                  <button id="qty-dec" type="button" class="cursor-pointer px-3 py-2 text-[#F5F5F5] transition-all hover:text-[#FF5500] active:scale-95">-</button>
                  <span id="qty" class="min-w-10 px-3 py-2 text-center text-sm font-semibold text-[#F5F5F5]">1</span>
                  <button id="qty-inc" type="button" class="cursor-pointer px-3 py-2 text-[#F5F5F5] transition-all hover:text-[#FF5500] active:scale-95">+</button>
                </div>
                <span class="text-lg font-bold text-[#F5F5F5] sm:hidden">{formatCOP(p.precio)}</span>
              </div>

              <button id="add-btn" type="button" class="flex w-full cursor-pointer items-center justify-between gap-4 rounded-xl bg-[#FF5500] px-5 py-3 text-white shadow-lg shadow-orange-600/30 transition-all hover:bg-[#E04800] active:scale-95 sm:w-auto sm:min-w-[240px]">
                <span class="font-bold">Agregar al pedido</span>
                <span id="total-price" class="font-bold">{formatCOP(p.precio)}</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <script define:vars={{ precio: p.precio, productId: p.id }}>
    let qty = 1;
    const qtyEl = document.getElementById('qty');
    const totalEl = document.getElementById('total-price');
    const dec = document.getElementById('qty-dec');
    const inc = document.getElementById('qty-inc');
    const addBtn = document.getElementById('add-btn');
    
    function update() {
      if (qtyEl) qtyEl.textContent = qty;
      if (totalEl) totalEl.textContent = '$' + (precio * qty).toLocaleString('es-CO');
    }
    
    dec?.addEventListener('click', () => {
      if (qty > 1) {
        qty--;
        update();
      }
    });
    
    inc?.addEventListener('click', () => {
      qty++;
      update();
    });
    
    addBtn?.addEventListener('click', () => {
      for (let i = 0; i < qty; i++) {
        document.dispatchEvent(new CustomEvent('smoky-add', { detail: { id: productId } }));
      }
      setTimeout(() => {
        document.getElementById('cart-open')?.click();
      }, 100);
    });
  </script>
</Base>
