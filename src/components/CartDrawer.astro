---
// Drawer lateral + barra móvil inferior + lógica de carrito (JS vanilla)
---
<div id="cart-backdrop" class="fixed inset-0 z-50 hidden bg-black/50"></div>

<aside
  id="cart-drawer"
  class="fixed right-0 top-0 z-50 flex h-full w-full max-w-md translate-x-full flex-col bg-white shadow-xl transition-transform duration-300"
  aria-hidden="true"
>
  <div class="flex items-center justify-between border-b p-4">
    <h2 class="text-lg font-black">Tu pedido</h2>
    <button id="cart-close" type="button" class="rounded-full bg-cream px-3 py-1.5 text-sm font-bold hover:bg-black/5">✕ Cerrar</button>
  </div>

  <div id="cart-items" class="flex-1 overflow-y-auto p-4 space-y-3"></div>

  <form id="checkout-form" class="space-y-3 border-t bg-cream/60 p-4">
    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
      <input required name="nombre" placeholder="Nombre" class="w-full min-w-0 rounded-xl border border-black/15 bg-white px-3 py-2 text-sm" />
      <input required name="telefono" type="tel" inputmode="numeric" pattern="[0-9]{10}" maxlength="10" placeholder="Celular (10 dígitos)" class="w-full min-w-0 rounded-xl border border-black/15 bg-white px-3 py-2 text-sm" />
    </div>
    <input required name="direccion" placeholder="Dirección de entrega" class="w-full min-w-0 rounded-xl border border-black/15 bg-white px-3 py-2 text-sm" />
    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
      <input name="barrio" placeholder="Barrio / zona" class="w-full min-w-0 rounded-xl border border-black/15 bg-white px-3 py-2 text-sm" />
      <select name="pago" class="w-full min-w-0 rounded-xl border border-black/15 bg-white px-3 py-2.5 text-sm">
        <option value="Efectivo">Efectivo</option>
        <option value="Bre-B">Bre-B</option>
      </select>
    </div>
    <textarea name="notas" placeholder="Notas" rows="2" class="w-full rounded-xl border border-black/15 bg-white px-3 py-2 text-sm"></textarea>

    <div class="flex items-center justify-between pt-1">
      <span class="text-sm text-smoke">Subtotal</span>
      <span id="cart-subtotal" class="text-sm font-bold">$0</span>
    </div>
    <div class="flex items-center justify-between">
      <span class="text-sm text-smoke">Domicilio</span>
      <span id="cart-delivery" class="text-sm font-bold">$0</span>
    </div>
    <div class="flex items-center justify-between">
      <span class="text-sm font-bold">Total</span>
      <span id="cart-total" class="text-xl font-black">$0</span>
    </div>
    <p id="cart-empty-msg" class="text-sm text-smoke">Tu carrito está vacío. Agrega una burger del menú.</p>
    <button
      id="checkout-btn"
      type="submit"
      class="w-full rounded-full bg-ember py-3 text-base font-black text-white hover:bg-ember-dark disabled:cursor-not-allowed disabled:opacity-50"
    >
      Pedir por WhatsApp →
    </button>
    <p class="text-center text-xs text-smoke">Te llevamos a WhatsApp con el pedido listo para enviar.</p>
  </form>
</aside>

<!-- Barra inferior móvil -->
<div id="cart-bar" class="fixed inset-x-0 bottom-0 z-40 hidden border-t border-black/10 bg-white/95 p-3 backdrop-blur">
  <button id="cart-bar-open" type="button" class="mx-auto flex w-full max-w-md items-center justify-between rounded-full bg-ember px-5 py-3 text-white hover:bg-ember-dark">
    <span class="text-sm font-bold">Ver carrito</span>
    <span id="cart-bar-total" class="font-black">$0</span>
  </button>
</div>

<script>
  import { productos, formatCOP } from '../data/menu';
  import { config } from '../config';

  const DELIVERY_COST = config.deliveryCost;
  type Item = { id: string; qty: number };
  const KEY = 'smokyburger-cart';
  const MAP = new Map(productos.map((p) => [p.id, p]));

  function load(): Item[] {
    try {
      return JSON.parse(localStorage.getItem(KEY) || '[]');
    } catch {
      return [];
    }
  }
  function save(items: Item[]) {
    localStorage.setItem(KEY, JSON.stringify(items));
    render(items);
  }
  function add(id: string) {
    const items = load();
    const found = items.find((i) => i.id === id);
    if (found) found.qty++;
    else items.push({ id, qty: 1 });
    save(items);
    open();
  }
  function setQty(id: string, qty: number) {
    let items = load();
    if (qty <= 0) items = items.filter((i) => i.id !== id);
    else items = items.map((i) => (i.id === id ? { ...i, qty } : i));
    save(items);
  }

  function render(items: Item[] = load()) {
    const wrap = document.getElementById('cart-items')!;
    const countEl = document.getElementById('cart-count')!;
    const subtotalEl = document.getElementById('cart-subtotal')!;
    const deliveryEl = document.getElementById('cart-delivery')!;
    const totalEl = document.getElementById('cart-total')!;
    const barTotalEl = document.getElementById('cart-bar-total')!;
    const bar = document.getElementById('cart-bar')!;
    const emptyMsg = document.getElementById('cart-empty-msg')!;
    const btn = document.getElementById('checkout-btn') as HTMLButtonElement;

    let total = 0;
    let count = 0;
    wrap.innerHTML = '';
    for (const item of items) {
      const p = MAP.get(item.id);
      if (!p) continue;
      total += p.precio * item.qty;
      count += item.qty;
      const row = document.createElement('div');
      row.className = 'flex items-center gap-3 rounded-2xl border border-black/10 p-3';
      row.innerHTML = `
        <img src="${p.foto}" alt="${p.nombre}" class="h-16 w-16 border border-black/10 object-contain bg-white p-0.5" />
        <div class="flex-1 min-w-0">
          <p class="truncate text-sm font-black">${p.nombre}</p>
          <p class="text-sm text-smoke">${formatCOP(p.precio)}</p>
          <div class="mt-1 flex items-center gap-2">
            <button data-dec type="button" class="h-7 w-7 rounded-full bg-cream font-black">−</button>
            <span class="w-6 text-center text-sm font-bold">${item.qty}</span>
            <button data-inc type="button" class="h-7 w-7 rounded-full bg-cream font-black">+</button>
          </div>
        </div>
        <span class="text-sm font-black">${formatCOP(p.precio * item.qty)}</span>
      `;
      row.querySelector('[data-dec]')?.addEventListener('click', () => setQty(p.id, item.qty - 1));
      row.querySelector('[data-inc]')?.addEventListener('click', () => setQty(p.id, item.qty + 1));
      wrap.appendChild(row);
    }

    const delivery = count > 0 ? DELIVERY_COST : 0;
    subtotalEl.textContent = formatCOP(total);
    deliveryEl.textContent = formatCOP(delivery);
    totalEl.textContent = formatCOP(total + delivery);
    barTotalEl.textContent = formatCOP(total + delivery);
    countEl.textContent = String(count);
    countEl.classList.toggle('hidden', count === 0);
    bar.classList.toggle('hidden', count === 0);
    emptyMsg.style.display = count === 0 ? 'block' : 'none';
    btn.disabled = count === 0;
  }

  function open() {
    document.getElementById('cart-drawer')?.classList.remove('translate-x-full');
    document.getElementById('cart-drawer')?.setAttribute('aria-hidden', 'false');
    document.getElementById('cart-backdrop')?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  function close() {
    document.getElementById('cart-drawer')?.classList.add('translate-x-full');
    document.getElementById('cart-drawer')?.setAttribute('aria-hidden', 'true');
    document.getElementById('cart-backdrop')?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  document.getElementById('cart-open')?.addEventListener('click', open);
  document.getElementById('cart-bar-open')?.addEventListener('click', open);
  document.getElementById('cart-close')?.addEventListener('click', close);
  document.getElementById('cart-backdrop')?.addEventListener('click', close);

  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest('[data-add-to-cart]') as HTMLElement | null;
    if (el) add(el.dataset.addToCart!);
  });

  document.addEventListener('smoky-add', ((e: CustomEvent) => {
    if (e.detail?.id) add(e.detail.id);
  }) as EventListener);

  // Checkout → WhatsApp
  document.getElementById('checkout-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data = new FormData(form);
    const items = load();
    if (!items.length) return;
    const telefono = (data.get('telefono') as string || '').replace(/\D/g, '');
    if (telefono.length !== 10) {
      alert('Por favor ingresa un número de celular válido de 10 dígitos.');
      return;
    }
    const lines = items.map((i) => {
      const p = MAP.get(i.id)!;
      return `• ${i.qty}x ${p.nombre} — ${formatCOP(p.precio * i.qty)}`;
    });
    const subtotal = items.reduce((s, i) => s + MAP.get(i.id)!.precio * i.qty, 0);
    const total = subtotal + DELIVERY_COST;
    const pago = data.get('pago') as string;
    const msgLines = [
      'Hola SmokyBurger 🔥 Quiero pedir:',
      ...lines,
      `Subtotal: ${formatCOP(subtotal)}`,
      `Domicilio: ${formatCOP(DELIVERY_COST)}`,
      `Total: ${formatCOP(total)}`,
      '',
      `Nombre: ${data.get('nombre')}`,
      `Celular: ${telefono}`,
      `Dirección: ${data.get('direccion')}`,
      `Barrio: ${data.get('barrio') || '-'}`,
      `Pago: ${pago}`,
      `Notas: ${data.get('notas') || '-'}`,
    ];
    msgLines.push('', 'Por favor enviar el soporte de pago para proceder con tu pedido.');
    const msg = msgLines.join('\n');
    const num = (window as any).__WHATSAPP_NUMBER__ || '573001234567';
    window.open(`https://wa.me/${num}?text=${encodeURIComponent(msg)}`, '_blank');

    if (pago === 'Bre-B') {
      const qrMsg = [
        'SmokyBurger - Código QR para pago Bre-B',
        '',
        `Pedido para: ${data.get('nombre')} - Celular: ${telefono}`,
        `Total: ${formatCOP(total)}`,
        '',
        'Escanea o descarga el código QR para realizar tu transferencia:',
        `${window.location.origin}/img/bree/Bree.jpg`,
        '',
        'Después de pagar, envía el soporte de pago a este WhatsApp para que procesemos tu pedido.',
      ].join('\n');
      window.open(`https://wa.me/57${telefono}?text=${encodeURIComponent(qrMsg)}`, '_blank');
    }

    localStorage.removeItem(KEY);
    render([]);
    close();
    form.reset();
  });

  render();
</script>
