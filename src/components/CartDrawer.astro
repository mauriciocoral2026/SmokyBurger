---
// Drawer lateral + barra móvil inferior + lógica de carrito (JS vanilla)
---
<div id="cart-backdrop" class="fixed inset-0 z-50 hidden bg-black/70 backdrop-blur-sm"></div>

<aside
  id="cart-drawer"
  class="fixed right-0 top-0 z-50 flex h-full w-full max-w-md translate-x-full flex-col border-l border-white/10 bg-[#121212] text-[#F5F5F5] shadow-2xl transition-transform duration-300"
  aria-hidden="true"
>
  <div class="flex items-center justify-between border-b border-white/10 p-4 sm:p-5">
    <h2 class="text-lg font-bold text-[#F5F5F5]">Tu pedido</h2>
    <button id="cart-close" type="button" class="inline-flex items-center justify-center rounded-xl border border-white/10 bg-[#1A1A1A] px-3 py-2 text-sm font-medium text-[#F5F5F5] transition-colors hover:border-white/20 hover:bg-[#222]">✕ Cerrar</button>
  </div>

  <div id="cart-items" class="flex-1 space-y-3 overflow-y-auto p-4 sm:p-5"></div>

  <form id="checkout-form" class="space-y-4 border-t border-white/10 bg-[#121212] p-4 sm:p-5">
    <div id="cart-empty-msg" class="rounded-xl border border-white/5 bg-[#1A1A1A] px-4 py-8 text-center">
      <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-white/5 text-[#A3A3A3]">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
          <path d="M3 6h18"></path>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
      </div>
      <p class="text-sm text-[#A3A3A3]">Tu carrito está vacío. Agrega una burger del menú.</p>
    </div>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      <input required name="nombre" placeholder="Nombre" class="w-full min-w-0 rounded-xl border border-white/10 bg-[#1A1A1A] px-3 py-2.5 text-base text-[#F5F5F5] placeholder:text-[#A3A3A3] focus:border-[#FF5500]/60 focus:outline-none md:text-sm" />
      <input required name="telefono" type="tel" inputmode="numeric" pattern="[0-9]{10}" maxlength="10" placeholder="Celular (10 dígitos)" class="w-full min-w-0 rounded-xl border border-white/10 bg-[#1A1A1A] px-3 py-2.5 text-base text-[#F5F5F5] placeholder:text-[#A3A3A3] focus:border-[#FF5500]/60 focus:outline-none md:text-sm" />
    </div>
    <input required name="direccion" placeholder="Dirección de entrega" class="w-full min-w-0 rounded-xl border border-white/10 bg-[#1A1A1A] px-3 py-2.5 text-base text-[#F5F5F5] placeholder:text-[#A3A3A3] focus:border-[#FF5500]/60 focus:outline-none md:text-sm" />
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      <input name="barrio" placeholder="Barrio / zona" class="w-full min-w-0 rounded-xl border border-white/10 bg-[#1A1A1A] px-3 py-2.5 text-base text-[#F5F5F5] placeholder:text-[#A3A3A3] focus:border-[#FF5500]/60 focus:outline-none md:text-sm" />
      <div class="sm:col-span-1">
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-[#A3A3A3]">Método de pago</p>
        <div class="grid grid-cols-2 gap-3">
          <label class="block cursor-pointer">
            <input type="radio" name="pago" value="Efectivo" class="peer sr-only" checked />
            <span class="flex h-full flex-col items-center justify-center rounded-xl border border-white/10 bg-[#1A1A1A] p-3 text-center text-sm font-medium text-[#F5F5F5] transition-colors peer-checked:border-orange-500 peer-checked:bg-orange-500/10">
              <span class="mb-1 text-base">💵</span>
              Efectivo
            </span>
          </label>
          <label class="block cursor-pointer">
            <input type="radio" name="pago" value="Bre-B" class="peer sr-only" />
            <span class="flex h-full flex-col items-center justify-center rounded-xl border border-white/10 bg-[#1A1A1A] p-3 text-center text-sm font-medium text-[#F5F5F5] transition-colors peer-checked:border-orange-500 peer-checked:bg-orange-500/10">
              <span class="mb-1 text-base">📲</span>
              Bre-B
            </span>
          </label>
        </div>
      </div>
    </div>
    <textarea name="notas" placeholder="Notas" rows="2" class="w-full rounded-xl border border-white/10 bg-[#1A1A1A] px-3 py-2.5 text-base text-[#F5F5F5] placeholder:text-[#A3A3A3] focus:border-[#FF5500]/60 focus:outline-none md:text-sm"></textarea>

    <div class="space-y-2 rounded-xl border border-white/5 bg-[#1A1A1A] p-4">
      <div class="flex items-center justify-between text-sm">
        <span class="text-[#A3A3A3]">Subtotal</span>
        <span id="cart-subtotal" class="font-medium text-[#F5F5F5]">$0</span>
      </div>
      <div class="flex items-center justify-between text-sm">
        <span class="text-[#A3A3A3]">Domicilio</span>
        <span id="cart-delivery" class="font-medium text-[#F5F5F5]">$0</span>
      </div>
      <div class="flex items-center justify-between border-t border-white/10 pt-3">
        <span class="text-base font-semibold text-[#F5F5F5]">Total</span>
        <span id="cart-total" class="text-xl font-bold text-white">$0</span>
      </div>
    </div>

    <button
      id="checkout-btn"
      type="submit"
      class="w-full rounded-xl bg-[#25D366] py-3.5 text-base font-bold text-[#0B1F14] shadow-lg shadow-green-500/20 transition-colors hover:bg-[#20BD5A] disabled:cursor-not-allowed disabled:opacity-50 disabled:shadow-none"
    >
      Pedir por WhatsApp →
    </button>
    <p class="text-center text-xs text-[#A3A3A3]">Te llevamos a WhatsApp con el pedido listo para enviar.</p>
  </form>
</aside>

<!-- Barra inferior móvil -->
<div id="cart-bar" class="fixed inset-x-0 bottom-0 z-40 hidden border-t border-[#2A2A2A] bg-[#121212]/95 p-3 backdrop-blur-md">
  <button id="cart-bar-open" type="button" class="mx-auto flex w-full max-w-md items-center justify-between rounded-xl bg-[#FF5500] px-5 py-3 text-white shadow-lg shadow-orange-600/20 hover:bg-[#E04800]">
    <span class="text-sm font-bold">Ver carrito</span>
    <span id="cart-bar-total" class="font-black">$0</span>
  </button>
</div>

<script>
  import { productos, formatCOP } from '../data/menu';
  import { config } from '../config';

  const DELIVERY_COST = config.deliveryCost;
  type Item = { id: string; qty: number };
  const KEY = 'smokyburger-cart';
  const MAP = new Map(productos.map((p) => [p.id, p]));

  function load(): Item[] {
    try {
      return JSON.parse(localStorage.getItem(KEY) || '[]');
    } catch {
      return [];
    }
  }
  function save(items: Item[]) {
    localStorage.setItem(KEY, JSON.stringify(items));
    render(items);
  }
  function add(id: string) {
    const items = load();
    const found = items.find((i) => i.id === id);
    if (found) found.qty++;
    else items.push({ id, qty: 1 });
    save(items);
    open();
  }
  function setQty(id: string, qty: number) {
    let items = load();
    if (qty <= 0) items = items.filter((i) => i.id !== id);
    else items = items.map((i) => (i.id === id ? { ...i, qty } : i));
    save(items);
  }

  function render(items: Item[] = load()) {
    const wrap = document.getElementById('cart-items')!;
    const countEl = document.getElementById('cart-count')!;
    const cartOpenBtn = document.getElementById('cart-open') as HTMLButtonElement | null;
    const subtotalEl = document.getElementById('cart-subtotal')!;
    const deliveryEl = document.getElementById('cart-delivery')!;
    const totalEl = document.getElementById('cart-total')!;
    const barTotalEl = document.getElementById('cart-bar-total')!;
    const bar = document.getElementById('cart-bar')!;
    const emptyMsg = document.getElementById('cart-empty-msg')!;
    const btn = document.getElementById('checkout-btn') as HTMLButtonElement;

    let total = 0;
    let count = 0;
    wrap.innerHTML = '';
    for (const item of items) {
      const p = MAP.get(item.id);
      if (!p) continue;
      total += p.precio * item.qty;
      count += item.qty;
      const row = document.createElement('div');
      row.className = 'flex items-center gap-3 rounded-xl border border-white/5 bg-[#1A1A1A] p-3';
      row.innerHTML = `
        <img src="${p.foto}" alt="${p.nombre}" width="${p.fotoW}" height="${p.fotoH}" loading="lazy" decoding="async" class="h-16 w-16 rounded-lg border border-white/10 bg-[#121212] object-cover" />
        <div class="min-w-0 flex-1">
          <p class="truncate text-sm font-semibold text-[#F5F5F5]">${p.nombre}</p>
          <p class="mt-0.5 text-sm text-[#A3A3A3]">${formatCOP(p.precio)}</p>
          <div class="mt-2 flex items-center gap-2">
            <button data-dec type="button" class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-[#121212] text-base font-bold text-[#F5F5F5] transition-colors hover:border-[#FF5500]/50 hover:text-[#FF5500]">−</button>
            <span class="w-6 text-center text-sm font-semibold text-[#F5F5F5]">${item.qty}</span>
            <button data-inc type="button" class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-[#121212] text-base font-bold text-[#F5F5F5] transition-colors hover:border-[#FF5500]/50 hover:text-[#FF5500]">+</button>
          </div>
        </div>
        <span class="text-sm font-bold text-[#F5F5F5]">${formatCOP(p.precio * item.qty)}</span>
      `;
      row.querySelector('[data-dec]')?.addEventListener('click', () => setQty(p.id, item.qty - 1));
      row.querySelector('[data-inc]')?.addEventListener('click', () => setQty(p.id, item.qty + 1));
      wrap.appendChild(row);
    }

    const delivery = count > 0 ? DELIVERY_COST : 0;
    subtotalEl.textContent = formatCOP(total);
    deliveryEl.textContent = formatCOP(delivery);
    totalEl.textContent = formatCOP(total + delivery);
    barTotalEl.textContent = formatCOP(total + delivery);
    const hasItems = count > 0;
    countEl.textContent = String(count);
    countEl.classList.toggle('hidden', !hasItems);
    bar.classList.toggle('hidden', !hasItems);
    if (cartOpenBtn) {
      cartOpenBtn.disabled = !hasItems;
      cartOpenBtn.setAttribute('aria-disabled', String(!hasItems));
    }
    emptyMsg.style.display = hasItems ? 'none' : 'block';
    btn.disabled = !hasItems;
  }

  function open() {
    document.getElementById('cart-drawer')?.classList.remove('translate-x-full');
    document.getElementById('cart-drawer')?.setAttribute('aria-hidden', 'false');
    document.getElementById('cart-backdrop')?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  function close() {
    document.getElementById('cart-drawer')?.classList.add('translate-x-full');
    document.getElementById('cart-drawer')?.setAttribute('aria-hidden', 'true');
    document.getElementById('cart-backdrop')?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  document.getElementById('cart-open')?.addEventListener('click', open);
  document.getElementById('cart-bar-open')?.addEventListener('click', open);
  document.getElementById('cart-close')?.addEventListener('click', close);
  document.getElementById('cart-backdrop')?.addEventListener('click', close);

  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest('[data-add-to-cart]') as HTMLElement | null;
    if (el) add(el.dataset.addToCart!);
  });

  document.addEventListener('smoky-add', ((e: CustomEvent) => {
    if (e.detail?.id) add(e.detail.id);
  }) as EventListener);

  const telefonoInput = document.querySelector('#checkout-form [name="telefono"]') as HTMLInputElement | null;
  telefonoInput?.addEventListener('input', () => {
    telefonoInput.value = telefonoInput.value.replace(/\D/g, '').slice(0, 10);
  });

  // Checkout → WhatsApp
  document.getElementById('checkout-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data = new FormData(form);
    const items = load();
    if (!items.length) return;
    const telefono = (data.get('telefono') as string || '').replace(/\D/g, '');
    if (telefono.length !== 10) {
      alert('Por favor ingresa un número de celular válido de 10 dígitos.');
      return;
    }
    const lines = items.map((i) => {
      const p = MAP.get(i.id)!;
      return `• ${i.qty}x ${p.nombre} — ${formatCOP(p.precio * i.qty)}`;
    });
    const subtotal = items.reduce((s, i) => s + MAP.get(i.id)!.precio * i.qty, 0);
    const total = subtotal + DELIVERY_COST;
    const pago = data.get('pago') as string;
    const msgLines = [
      'Hola SmokyBurger 🔥 Quiero pedir:',
      ...lines,
      `Subtotal: ${formatCOP(subtotal)}`,
      `Domicilio: ${formatCOP(DELIVERY_COST)}`,
      `Total: ${formatCOP(total)}`,
      '',
      `Nombre: ${data.get('nombre')}`,
      `Celular: ${telefono}`,
      `Dirección: ${data.get('direccion')}`,
      `Barrio: ${data.get('barrio') || '-'}`,
      `Pago: ${pago}`,
      `Notas: ${data.get('notas') || '-'}`,
    ];
    msgLines.push('', 'Por favor enviar el soporte de pago para proceder con tu pedido.');
    const msg = msgLines.join('\n');
    const num = (window as any).__WHATSAPP_NUMBER__ || '573001234567';
    window.open(`https://wa.me/${num}?text=${encodeURIComponent(msg)}`, '_blank');

    if (pago === 'Bre-B') {
      const qrMsg = [
        'SmokyBurger - Código QR para pago Bre-B',
        '',
        `Pedido para: ${data.get('nombre')} - Celular: ${telefono}`,
        `Total: ${formatCOP(total)}`,
        '',
        'Escanea o descarga el código QR para realizar tu transferencia:',
        `${window.location.origin}/img/bree/Bree.jpg`,
        '',
        'Después de pagar, envía el soporte de pago a este WhatsApp para que procesemos tu pedido.',
      ].join('\n');
      window.open(`https://wa.me/57${telefono}?text=${encodeURIComponent(qrMsg)}`, '_blank');
    }

    localStorage.removeItem(KEY);
    render([]);
    close();
    form.reset();
  });

  // Limpiar carrito al iniciar la aplicación
  localStorage.removeItem(KEY);
  render([]);
</script>
