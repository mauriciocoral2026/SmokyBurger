---
import { config } from '../config';

const { currentPath = '/' } = Astro.props;
const isActive = (path: string) => currentPath === path;
---
<header class="sticky top-0 z-40 border-b border-black/10 bg-[#ebe5d9]">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2">
      <span class="text-lg font-bold tracking-tight text-ink">{config.brand}</span>
    </a>

    <nav class="ml-6 hidden items-center gap-6 text-sm md:flex">
      <a href="/" class:list={['text-ink hover:text-ember', isActive('/') && 'font-medium']}>Inicio</a>
      <a href="/menu" class:list={['text-ink hover:text-ember', isActive('/menu') && 'font-medium']}>Pedir</a>
      <a href="/ubicacion" class:list={['text-ink hover:text-ember', isActive('/ubicacion') && 'font-medium']}>Ubicación</a>
    </nav>

    <button
      id="cart-open"
      class="ml-auto inline-flex items-center gap-2 rounded-full bg-ember px-4 py-2 text-sm font-medium text-white hover:bg-ember-dark"
      type="button"
      aria-label="Abrir carrito"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 10a4 4 0 0 1-8 0"></path>
        <path d="M3.103 6.034h17.794"></path>
        <path d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z"></path>
      </svg>
      <span>Carrito</span>
      <span id="cart-count" class="hidden min-w-5 rounded-full bg-white px-1.5 text-xs font-bold text-ember">0</span>
    </button>
  </div>
</header>
