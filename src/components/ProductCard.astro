---
import { Image } from 'astro:assets';
import type { Producto } from '../data/menu';
import { formatCOP } from '../data/menu';

interface Props {
  producto: Producto;
}
const { producto } = Astro.props;
const nombre = producto.nombre.replace(' — Smoky Burger', '');
const badge = producto.popular ? 'Recomendada' : (producto.badge ?? null);
const productData = JSON.stringify({
  id: producto.id,
  nombre,
  nombreCompleto: producto.nombre,
  descripcion: producto.descripcion,
  ingredientes: producto.ingredientes,
  precio: producto.precio,
  precioLabel: formatCOP(producto.precio),
  foto: producto.foto,
  fotoW: producto.fotoW,
  fotoH: producto.fotoH,
  badge: badge || '🔥 ESPECIALIDAD AL BARRIL',
});
---
<article
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-[#181818] transition-all duration-300 hover:-translate-y-1 hover:border-orange-500/50"
  data-product={productData}
>
  <a href={`/menu/${producto.slug}`} aria-label={producto.nombre} class="block cursor-pointer transition-transform active:scale-95" data-product-open={producto.id}>
    <div class="relative aspect-[4/5] w-full overflow-hidden bg-gradient-to-b from-[#1F1F1F] to-[#141414]">
      <Image
        src={producto.foto}
        alt={producto.nombre}
        title={producto.nombre}
        width={producto.fotoW}
        height={producto.fotoH}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-contain p-2 transition-transform duration-500 group-hover:scale-105"
      />
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-[#141414] to-transparent"></div>
      {badge && (
        <span class="absolute left-3 top-3 rounded-full border border-white/10 bg-black/60 px-3 py-1 text-xs font-semibold text-[#FF5500] backdrop-blur-md">
          {badge}
        </span>
      )}
    </div>
  </a>

  <div class="flex flex-1 flex-col p-4 sm:p-5">
    <a href={`/menu/${producto.slug}`} class="block cursor-pointer transition-transform active:scale-95" data-product-open={producto.id}>
      <h3 class="text-xl font-bold text-[#F5F5F5]">{nombre}</h3>
      <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-[#A3A3A3]">
        {producto.descripcion}
      </p>
    </a>

    <div class="mt-auto flex items-center justify-between gap-3 pt-5">
      <span class="text-lg font-bold text-[#F5F5F5]">{formatCOP(producto.precio)}</span>
      <button
        data-add-to-cart={producto.id}
        class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl bg-[#FF5500] px-4 py-2.5 text-sm font-bold text-white transition-all duration-200 hover:bg-[#E04800] active:scale-95"
        type="button"
        aria-label={`Agregar ${producto.nombre} al carrito`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"></path>
          <path d="M12 5v14"></path>
        </svg>
        <span>Agregar</span>
      </button>
    </div>
  </div>
</article>
