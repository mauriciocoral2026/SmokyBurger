---
import { Image } from 'astro:assets';
import type { Producto } from '../data/menu';
import { formatCOP } from '../data/menu';

interface Props {
  producto: Producto;
}
const { producto } = Astro.props;
---
<article class="group relative overflow-hidden rounded-2xl bg-white shadow-lg transition-shadow hover:shadow-xl">
  <a href={`/menu/${producto.slug}`} aria-label={producto.nombre}>
    <div class="relative h-48 w-full overflow-hidden bg-white">
      <Image
        src={producto.foto}
        alt={producto.nombre}
        title={producto.nombre}
        width={producto.fotoW}
        height={producto.fotoH}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-contain p-4"
      />
      <span class="absolute left-3 top-3 rounded-full bg-[#ff520d] px-3 py-1 text-xs font-medium text-white">
        Burger
      </span>
    </div>
    <div class="p-4">
      <h3 class="text-lg font-bold text-black">{producto.nombre.replace(' — Smoky Burger', '')}</h3>
      <p class="mt-1 line-clamp-2 text-sm text-gray-600">
        {producto.descripcion.includes('Pan') ? producto.descripcion.split(',').slice(0,3).join(', ') + '...' : producto.descripcion + '...'}
      </p>
      <div class="mt-3 flex items-center justify-between">
        <span class="text-base font-bold text-black">{formatCOP(producto.precio)}</span>
      </div>
    </div>
  </a>
  <button
    data-add-to-cart={producto.id}
    class="absolute bottom-3 right-3 grid h-8 w-8 place-items-center rounded-full bg-[#ff520d] text-lg font-bold leading-none text-white hover:bg-[#e0480b]"
    type="button"
    aria-label={`Agregar ${producto.nombre} al carrito`}
  >
    +
  </button>
</article>
