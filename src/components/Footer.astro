---
import { config } from '../config';
const horario = config.hours.map((h) => `${h.days.charAt(0).toUpperCase() + h.days.slice(1)}: ${h.time}`).join(' · ');
---
<footer class="border-t border-white/10 bg-[#080808] text-[#F5F5F5]">
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 px-4 py-12 sm:px-6 md:grid-cols-2 lg:grid-cols-4 lg:px-8">
    <div>
      <span class="font-display text-2xl font-semibold uppercase tracking-wide text-[#F5F5F5]">{config.brand}</span>
      <p class="mt-3 text-sm leading-relaxed text-[#A3A3A3]">Burgers ahumadas al barril. Ubicados afuera de New People (Cartago). Come al paso, recoge o pide a domicilio.</p>
      <div class="mt-4 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-[#F5F5F5]">
        <span class="h-2.5 w-2.5 rounded-full bg-[#FF5500] shadow-[0_0_0_4px_rgba(255,85,0,0.15)]"></span>
        <span>{horario}</span>
      </div>
    </div>

    <div>
      <h4 class="text-sm font-semibold uppercase tracking-wide text-[#F5F5F5]">Conócenos</h4>
      <ul class="mt-4 space-y-2 text-sm text-[#A3A3A3]">
        <li><a class="transition-colors hover:text-[#FF5500]" href="/ubicacion">Despacho</a></li>
        <li><a class="transition-colors hover:text-[#FF5500]" href="/terminos">Términos y condiciones</a></li>
        <li><a class="transition-colors hover:text-[#FF5500]" href="/privacidad">Política de privacidad</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-sm font-semibold uppercase tracking-wide text-[#F5F5F5]">Redes y Contacto</h4>
      <ul class="mt-4 space-y-3 text-sm">
        <li>
          <a class="inline-flex w-full items-center gap-3 rounded-xl border border-white/10 bg-[#181818] px-4 py-3 text-[#A3A3A3] transition-colors hover:border-[#FF5500]/40 hover:text-[#F5F5F5]" href={config.instagram} target="_blank" rel="noreferrer">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#FF5500]" aria-hidden="true">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
            </svg>
            <span><span class="block text-xs text-[#A3A3A3]">Instagram</span><span class="font-medium text-[#F5F5F5]">{config.instagramHandle}</span></span>
          </a>
        </li>
        <li>
          <a class="inline-flex w-full items-center gap-3 rounded-xl border border-white/10 bg-[#181818] px-4 py-3 text-[#A3A3A3] transition-colors hover:border-[#FF5500]/40 hover:text-[#F5F5F5]" href={`https://wa.me/${config.whatsappNumber}`} target="_blank" rel="noreferrer">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#FF5500]" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.63 2.62a2 2 0 0 1-.45 2.11L8 9.91a16 16 0 0 0 6 6l1.46-1.29a2 2 0 0 1 2.11-.45c.84.3 1.72.51 2.62.63A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span><span class="block text-xs text-[#A3A3A3]">WhatsApp</span><span class="font-medium text-[#F5F5F5]">{config.whatsappDisplay}</span></span>
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h4 class="text-sm font-semibold uppercase tracking-wide text-[#F5F5F5]">Haz tu pedido</h4>
      <ul class="mt-4 space-y-3 text-sm text-[#A3A3A3]">
        <li><a class="inline-flex items-center rounded-xl bg-[#FF5500] px-5 py-2.5 font-semibold text-white transition-colors hover:bg-[#E04800]" href="/menu">Pedir</a></li>
        <li class="pt-1 text-[#A3A3A3]">Atención: <span class="font-medium text-[#F5F5F5]">{horario}</span></li>
      </ul>
    </div>
  </div>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="border-t border-white/5 mt-10 pt-6 pb-6 text-center text-xs text-neutral-500">
      © {new Date().getFullYear()} {config.brand}
    </div>
  </div>
</footer>
