---
import { config } from '../config';
---
<footer class="bg-[#262626] text-[#ebe5d9]">
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:grid-cols-2 lg:grid-cols-4 sm:px-6 lg:px-8">
    <div>
      <div class="flex items-center gap-2">
        <span class="text-lg font-bold">{config.brand}</span>
      </div>
      <p class="mt-3 text-sm leading-relaxed text-[#ebe5d9]/70">{config.tagline}. Cocina oculta, despacho rápido y caliente.</p>
    </div>
    <div>
      <h4 class="font-bold">Conócenos</h4>
      <ul class="mt-3 space-y-2 text-sm text-[#ebe5d9]/70">
        <li><a class="hover:text-white" href="/ubicacion">Despacho</a></li>
        <li><a class="hover:text-white" href="/terminos">Términos y condiciones</a></li>
        <li><a class="hover:text-white" href="/privacidad">Política de privacidad</a></li>
      </ul>
    </div>
    <div>
      <h4 class="font-bold">Redes sociales</h4>
      <ul class="mt-3 space-y-2 text-sm text-[#ebe5d9]/70">
        <li><a class="hover:text-white" href={config.instagram} target="_blank" rel="noreferrer">Instagram {config.instagramHandle}</a></li>
        <li><a class="hover:text-white" href={`https://wa.me/${config.whatsappNumber}`} target="_blank" rel="noreferrer">WhatsApp {config.whatsappDisplay}</a></li>
      </ul>
    </div>
    <div>
      <h4 class="font-bold">Mi cuenta</h4>
      <ul class="mt-3 space-y-2 text-sm text-[#ebe5d9]/70">
        <li><a class="inline-flex items-center rounded-full bg-ember px-4 py-2 text-white hover:bg-ember-dark" href="/menu">Pedir</a></li>
        <li class="pt-2"><span>{config.hours.map((h) => `${h.days}: ${h.time}`).join(' · ')}</span></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10 py-4 text-center text-xs text-[#ebe5d9]/50">
    © {new Date().getFullYear()} {config.brand}
  </div>
</footer>
