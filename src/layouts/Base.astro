---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { config } from '../config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description, image } = Astro.props;
const pageTitle = title ? `${title} | ${config.brand}` : `${config.brand} | ${config.tagline}`;
const pageDesc = description || config.description;
const pageImage = image || `${config.baseUrl}/img/burgers/explosion-de-barril.jpg`;
const canonical = new URL(Astro.url.pathname, config.baseUrl).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Restaurant',
      '@id': `${config.baseUrl}/#restaurant`,
      name: config.brand,
      description: config.description,
      url: config.baseUrl,
      telephone: `+${config.whatsappNumber}`,
      email: config.email,
      address: { '@type': 'PostalAddress', addressLocality: 'Cartago', addressRegion: 'Valle del Cauca', addressCountry: 'CO' },
      servesCuisine: ['Burgers'],
      priceRange: '$$',
    },
  ],
};
---
<!doctype html>
<html lang="es-CO" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={pageImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script define:vars={{ whatsappNumber: config.whatsappNumber }}>
      window.__WHATSAPP_NUMBER__ = whatsappNumber;
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header currentPath={Astro.url.pathname} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
  </body>
</html>
